{
  "name": "ebike-battery-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages && node scripts/build-service-worker.mjs",
    "cert:lan": "node scripts/lan-cert.mjs",
    "lan": "vite --mode lan",
    "lint": "eslint . --ignore-pattern dist-pages",
    "preview": "vite preview",
    "generate-api": "node scripts/generate-api.mjs",
    "deploy": "gh-pages -d dist-pages --nojekyll",
    "predeploy": "npm run build:pages"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "axios": "1.20.0",
    "bootstrap": "^5.3.8",
    "react": "^19.1.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.0",
    "react-redux": "9.3.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "22.19.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "6.3.0",
    "globals": "^16.0.0",
    "swagger-typescript-api": "13.13.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
